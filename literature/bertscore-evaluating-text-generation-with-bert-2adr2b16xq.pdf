2 0 obj
<<
/Producer (PyPDF2)
/Title (BERTScore\072\040Evaluating\040Text\040Generation\040with\040BERT)
/Author (Tianyi\040Zhang\054\040Varsha\040Kishore\054\040Felix\040Wu\054\040Kilian\040Q\056\040Weinberger\054\040Yoav\040Artzi)
/Subject (We\040propose\040BERTScore\054\040an\040automatic\040evaluation\040metric\040for\040text\040generation\056\040Analogously\040to\040common\040metrics\054\040BERTScore\040computes\040a\040similarity\040score\040for\040each\040token\040in\040the\040candidate\040sentence\040with\040each\040token\040in\040the\040reference\040sentence\056\040However\054\040instead\040of\040exact\040matches\054\040we\040compute\040token\040similarity\040using\040contextual\040embeddings\056\040We\040evaluate\040using\040the\040outputs\040of\040363\040machine\040translation\040and\040image\040captioning\040systems\056\040BERTScore\040correlates\040better\040with\040human\040judgments\040and\040provides\040stronger\040model\040selection\040performance\040than\040existing\040metrics\056\040Finally\054\040we\040use\040an\040adversarial\040paraphrase\040detection\040task\040and\040show\040that\040BERTScore\040is\040more\040robust\040to\040challenging\040examples\040compared\040to\040existing\040metrics\056)
/Keywords (30\040Apr\0402020\054\040International\040Conference\040on\040Learning\040Representations\054\040Sentence\054\040Machine\040translation\054\040Cornell\040University)
>>
endobj
